{
  "name": "curso-dev",
  "version": "1.0.0",
  "description": "starting new project",
  "main": "index.js",
  "scripts": {
    "dev:db": "npm run services:up && npm run scripts:wait-for-databas && next dev",
    "dev": "next dev",
    "dev:test": "NODE_ENV=test next dev",
    "start": "next start",
    "build": "next build",
    "type-check": "tsc --noEmit",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "migration:create": "tsx ./node_modules/.bin/node-pg-migrate create -m src/database/migrations -j js",
    "migration:up": "tsx ./node_modules/.bin/node-pg-migrate up -m src/database/migrations -j js",
    "build:migrations": "tsc src/database/migrations/*.ts --outDir dist/migrations --target es2020 --module commonjs",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "lint": "npx eslint . --ext .ts,.tsx,.js,.jsx",
    "test": "jest --runInBand",
    "test:watch": "jest --watchAll --runInBand",
    "test:integration": "jest --testPathPattern=tests/integration --runInBand",
    "test:coverage": "jest --coverage",
    "docker:test:build": "docker compose -f infra/docker-compose.test.yml up --build --force-recreate -d",
    "scripts:migrations": "node ./scripts/migration.js",
    "scripts:wait-for-database": "node ./scripts/wait-for-database.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "config": "^3.3.12",
    "dotenv": "^17.2.1",
    "next": "^15.5.0",
    "node-pg-migrate": "^6.2.2",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "19.1.10",
    "eslint": "9.33.0",
    "eslint-config-next": "15.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.4",
    "typescript": "5.9.2"
  }
}
